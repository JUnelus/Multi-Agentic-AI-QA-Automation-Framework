{
  "name": "multi-agentic-ai-qa-automation-framework",
  "version": "1.0.0",
  "description": "A scalable multi-agent AI QA automation framework that converts application URLs into structured manual test cases and Playwright TypeScript automation.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "agent:generate-testcases": "tsx agents/agent1-testcase-creator.ts",
    "agent:generate-scripts": "tsx agents/agent2-script-generator.ts",
    "agent:run": "tsx agents/orchestrator.ts",
    "test:saucedemo": "playwright test --project=saucedemo",
    "typecheck": "tsc --noEmit",
    "test:framework": "tsx --test tests/framework/*.spec.ts",
    "typecheck:generated": "tsc --noEmit -p tsconfig.generated.json",
    "test:generated:list": "playwright test -c playwright.generated.config.ts --list",
    "test:generated": "playwright test -c playwright.generated.config.ts",
    "validate:generated": "npm run typecheck:generated && npm run test:generated:list",
    "test:uitestingplayground": "playwright test --project=uitestingplayground --pass-with-no-tests",
    "test:generated:fixture": "playwright test -c playwright.generated.config.ts --project=generated-fixture",
    "agent:explore": "tsx agents/agent0-application-explorer.ts",
    "agent:validate-repair": "tsx agents/agent3-validation-repair.ts",
    "pipeline:saucedemo": "tsx agents/orchestrator.ts --app saucedemo",
    "pipeline:uitestingplayground": "tsx agents/orchestrator.ts --app uitestingplayground",
    "pipeline:saucedemo:no-ai": "tsx agents/orchestrator.ts --app saucedemo --no-ai",
    "format:check": "prettier --check agents shared tests/framework tests/fixtures docs README.md playwright*.ts tsconfig*.json .github/workflows package.json",
    "validate": "npm run typecheck && npm run test:framework && npm run test:saucedemo && npm run validate:generated && npm run test:generated:fixture"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUnelus/Multi-Agentic-AI-QA-Automation-Framework.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JUnelus/Multi-Agentic-AI-QA-Automation-Framework/issues"
  },
  "homepage": "https://github.com/JUnelus/Multi-Agentic-AI-QA-Automation-Framework#readme",
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "openai": "^6.38.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
